# ==============================================================================
# SEO Automation Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the required values
# This configuration is compatible with Pydantic BaseSettings auto-discovery
#
# REQUIRED: Values that MUST be set
# OPTIONAL: Values with sensible defaults
# PLACEHOLDER: Values that need real credentials in production

# ==============================================================================
# ENVIRONMENT SETTINGS
# ==============================================================================
# Environment type: development, staging, production
ENVIRONMENT=development

# Debug mode - enables verbose logging and development features
DEBUG=true

# Application name and version for logging and monitoring
APP_NAME=seo-automation-platform
APP_VERSION=1.0.0

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==============================================================================
# DATABASE CONFIGURATION - PostgreSQL 16 + TimescaleDB + pgvector
# ==============================================================================
# Primary database connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seo_platform
POSTGRES_USER=seo
POSTGRES_PASSWORD=your_secure_postgres_password_here  # REQUIRED

# Database connection pool settings
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=5
POSTGRES_POOL_TIMEOUT=30

# Full connection URL (auto-generated by BaseSettings if components provided)
# DATABASE_URL=postgresql://seo:password@localhost:5432/seo_platform

# TimescaleDB specific settings
TIMESCALEDB_ENABLED=true
TIMESCALE_CHUNK_TIME_INTERVAL=7d

# pgvector settings for semantic similarity
PGVECTOR_ENABLED=true
VECTOR_DIMENSION=1536  # OpenAI Ada-002 embedding dimension

# ==============================================================================
# REDIS CONFIGURATION - Task Queue & Caching
# ==============================================================================
# Redis connection settings for task queues using Redis Streams
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # OPTIONAL - leave empty for development

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=30
REDIS_SOCKET_CONNECT_TIMEOUT=30

# Full connection URL (auto-generated by BaseSettings if components provided)
# REDIS_URL=redis://localhost:6379/0

# Task queue configuration
REDIS_STREAM_NAME=seo:tasks
REDIS_CONSUMER_GROUP=seo-agents
REDIS_CONSUMER_TIMEOUT=30000  # milliseconds
REDIS_MAX_STREAM_LENGTH=10000

# Caching settings
REDIS_CACHE_TTL=3600  # seconds (1 hour)
REDIS_CACHE_PREFIX=seo:cache

# ==============================================================================
# NATS CONFIGURATION - Approval Workflows & Notifications  
# ==============================================================================
# NATS server connection settings for human approval workflows
NATS_HOST=localhost
NATS_PORT=4222
NATS_HTTP_PORT=8222

# NATS authentication (optional in development)
NATS_USER=
NATS_PASSWORD=

# Full connection URL (auto-generated by BaseSettings if components provided)
# NATS_URL=nats://localhost:4222

# JetStream configuration for durable approval workflows
NATS_JETSTREAM_ENABLED=true
NATS_STREAM_APPROVAL=seo-approvals
NATS_STREAM_ALERTS=seo-alerts
NATS_STREAM_TASKS=seo-tasks

# Approval workflow settings
APPROVAL_TIMEOUT=300  # seconds (5 minutes default)
APPROVAL_RETRY_ATTEMPTS=3
APPROVAL_SUBJECTS_PREFIX=approvals

# ==============================================================================
# EXTERNAL API KEYS - Third-party integrations
# ==============================================================================

# Google Search Console API
# Get from: https://console.cloud.google.com/apis/credentials
GSC_API_KEY=your_google_search_console_api_key_here  # REQUIRED
GSC_CLIENT_ID=your_gsc_client_id_here                # REQUIRED  
GSC_CLIENT_SECRET=your_gsc_client_secret_here         # REQUIRED
GSC_REDIRECT_URI=http://localhost:3000/auth/gsc/callback

# Google Analytics 4 API  
# Get from: https://console.cloud.google.com/apis/credentials
GA4_API_KEY=your_google_analytics_4_api_key_here      # REQUIRED
GA4_CLIENT_ID=your_ga4_client_id_here                 # REQUIRED
GA4_CLIENT_SECRET=your_ga4_client_secret_here         # REQUIRED
GA4_REDIRECT_URI=http://localhost:3000/auth/ga4/callback

# SerpAPI for SERP analysis (Micro plan: $50/month, 5000 searches)
# Get from: https://serpapi.com/dashboard
SERPAPI_KEY=your_serpapi_key_here                     # REQUIRED

# Rate limiting for external APIs (requests per minute)
API_RATE_LIMIT_GSC=200
API_RATE_LIMIT_GA4=200  
API_RATE_LIMIT_SERPAPI=100

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================
# JWT token settings for API authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production  # REQUIRED
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for sensitive data storage (32 bytes, base64 encoded)
ENCRYPTION_KEY=your_32_byte_base64_encoded_encryption_key_here  # REQUIRED

# CORS settings for web dashboard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# API security settings
API_MAX_REQUESTS_PER_MINUTE=100
API_MAX_REQUESTS_PER_HOUR=1000

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Web dashboard settings (Next.js)
WEB_HOST=localhost
WEB_PORT=3000
WEB_URL=http://localhost:3000

# Agent orchestration settings
AGENT_MAX_CONCURRENT_TASKS=5
AGENT_TASK_TIMEOUT=1800  # seconds (30 minutes)
AGENT_RETRY_ATTEMPTS=3
AGENT_BACKOFF_FACTOR=2

# Content generation settings
CONTENT_MAX_WORDS=2000
CONTENT_MIN_WORDS=300
CONTENT_READABILITY_TARGET=8  # Flesch-Kincaid grade level

# SEO analysis settings  
SEO_KEYWORD_DENSITY_MAX=3.0  # percentage
SEO_TITLE_LENGTH_MAX=60
SEO_META_DESCRIPTION_LENGTH_MAX=155
SEO_H1_COUNT_MAX=1

# ==============================================================================
# CMS INTEGRATION SETTINGS
# ==============================================================================
# WordPress integration settings
WORDPRESS_SITES=  # JSON array of site configurations (set in production)
WORDPRESS_DEFAULT_AUTHOR_ID=1
WORDPRESS_POST_STATUS=draft  # draft, publish (draft for safety)
WORDPRESS_MEDIA_UPLOAD_MAX_SIZE=5242880  # 5MB in bytes

# Custom CMS integration settings
CUSTOM_CMS_API_BASE_URL=
CUSTOM_CMS_API_KEY=
CUSTOM_CMS_WEBHOOK_SECRET=

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
# Application monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=30  # seconds
METRICS_COLLECTION_ENABLED=true

# Performance monitoring
PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=1000  # milliseconds
SLOW_API_CALL_THRESHOLD=5000  # milliseconds

# ==============================================================================
# DEVELOPMENT SPECIFIC SETTINGS
# ==============================================================================
# Development mode toggles
DEV_AUTO_MIGRATE=true
DEV_SEED_DATABASE=false
DEV_MOCK_EXTERNAL_APIS=false
DEV_SKIP_APPROVAL_GATE=false  # NEVER set to true in production

# Testing settings
TEST_DATABASE_URL=postgresql://seo:password@localhost:5432/seo_platform_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_NATS_URL=nats://localhost:4222

# ==============================================================================
# PRODUCTION TOGGLES
# ==============================================================================
# Production environment overrides (set these in production .env)
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# DEV_AUTO_MIGRATE=false
# DEV_SEED_DATABASE=false
# DEV_MOCK_EXTERNAL_APIS=false
# DEV_SKIP_APPROVAL_GATE=false
# POSTGRES_PASSWORD=strong_production_password
# REDIS_PASSWORD=strong_redis_password
# JWT_SECRET_KEY=strong_production_jwt_secret
# ENCRYPTION_KEY=strong_production_encryption_key